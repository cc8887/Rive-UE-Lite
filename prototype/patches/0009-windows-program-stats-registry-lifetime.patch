 FSpanAllocatorStatsRegistry& FSpanAllocatorStatsRegistry::Get()
 {
+#if PLATFORM_WINDOWS && IS_PROGRAM && IS_MONOLITHIC
+	// Global renderer owners can be constructed before their first registration.
+	// Their CRT destructors consequently run after a function-static registry's
+	// destructor. Keep this process registry alive for those final Unregisters.
+	static FSpanAllocatorStatsRegistry* Registry = new FSpanAllocatorStatsRegistry;
+	return *Registry;
+#else
 	static FSpanAllocatorStatsRegistry Registry;
 	return Registry;
+#endif
 }
 
